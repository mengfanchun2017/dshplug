{
  "name": "dsh-synchub",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "同步中心：把 DSH 的会话、工作区、附件、技能与配置层同步到各自的私有 Git 仓库；提供同步面分级、危险目录守卫、环境切换检测与一键同步。",
  "keywords": ["dsh", "dsh-plugin", "sync", "git", "session", "backup", "sidebar"],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots"],
      "platform": "web"
    }
  }
}
