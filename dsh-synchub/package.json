{
  "name": "dsh-synchub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "同步中心：侧边栏 + 设置面板，汇总 chatsync / dsh-config-manager / 工作区 Git 的同步状态，一键发起同步，改配置与自检，旧版本红点提醒。",
  "keywords": ["dsh", "dsh-plugin", "sync", "dashboard", "sidebar"],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots"],
      "platform": "web"
    }
  }
}
