*.secret
*.key
getbraindata/
data/
snapshots/
audit/
state/
downloads/
intermediate/
logs/
*.jsonl

# Python
*.pyc
__pycache__/
.venv/
venv/

# 打包 / 大二进制产物（由脚本重新生成或下载）
dist/
*.zip
*.tgz
*.tar.gz
MANIFEST.txt
*.exe

# 各插件的运行期私有目录（含明文凭据，dsh-larkcli 实测已挡住）
