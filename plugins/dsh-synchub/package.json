{
  "name": "dsh-synchub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "同步中心：在一个侧边栏面板里汇总 chatsync / dsh-config-manager / 工作区 Git 的同步状态，一键发起同步，并在配置落后或插件过旧时红点提醒。",
  "keywords": ["dsh", "dsh-plugin", "sync", "dashboard", "sidebar"],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "chatsync": ">=0.21.0 <0.30.0-0",
    "dsh-config-manager": ">=0.8.0 <0.9.0-0"
  },
  "peerDependenciesMeta": {
    "chatsync": { "optional": true },
    "dsh-config-manager": { "optional": true }
  }
}
