{
  "name": "dsh-larkcli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "飞书/Lark 原生驱动（Windows only，不靠 WSL、不装系统 Node）：直连官方 lark-cli.exe，多账户（每账户独立 App + 独立 user 授权，可写描述与标签），按任务本地搜索账户降低消耗；提供 lark_status / lark_call / lark_schema / lark_account_* / lark_login_* 工具与设置面板。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "lark-cli",
    "windows",
    "multi-account"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/core.js",
    "lib/service.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lark.ps1",
    "lark-native-setup.md",
    "scripts/fetch-lark-cli.ps1",
    "README.md",
    "BOOTSTRAP.md",
    "ADR.md"
  ],
  "scripts": {
    "lark": "pwsh -NoProfile -File ./lark.ps1",
    "fetch-binary": "pwsh -NoProfile -File ./scripts/fetch-lark-cli.ps1",
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
