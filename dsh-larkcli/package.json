{
  "name": "dsh-larkcli",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "飞书/Lark 原生驱动（Windows only，不靠 WSL、不装系统 Node）：一键安装与升级官方 lark-cli.exe（镜像下载 + SHA256 校验 + 原子替换），多账户（每账户独立 App + 独立 user 授权），展示接入的飞书应用名/描述/头像与用户名，按任务本地搜索账户，权限清单可一键申请；提供 13 个工具与设置面板。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "lark-cli",
    "windows",
    "multi-account"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/core.js",
    "lib/service.js",
    "lib/install.js",
    "lib/scopes.js",
    "lib/identity.js",
    "lib/resolver.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lark.ps1",
    "lark-native-setup.md",
    "test/*.mjs",
    "README.md",
    "BOOTSTRAP.md",
    "ADR.md"
  ],
  "scripts": {
    "lark": "pwsh -NoProfile -File ./lark.ps1",
    "test": "node test/run.mjs",
    "test:all": "node test/run.mjs && node test/tools.mjs && node test/client.mjs && node test/smoke.mjs && node test/v2.mjs && node test/activate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
